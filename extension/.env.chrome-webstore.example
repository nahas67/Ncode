# Chrome Web Store publishing configuration.
# Copy this file to `.env.chrome-webstore` (git-ignored) and fill in the values.
# The release zip path is resolved at publish time by scripts/chrome-webstore-publish.mjs;
# never pin a release version in this template (the version comes from manifest.json).

CHROME_WEBSTORE_CLIENT_ID=
CHROME_WEBSTORE_CLIENT_SECRET=
CHROME_WEBSTORE_REFRESH_TOKEN=
CHROME_WEBSTORE_PUBLISHER_ID=
CHROME_WEBSTORE_ITEM_ID=
CHROME_WEBSTORE_ZIP_PATH=artifacts/ncode-extension.zip
