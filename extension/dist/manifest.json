{
  "manifest_version": 3,
  "name": "Ncode",
  "short_name": "Ncode",
  "version": "1.0.0",
  "description": "Ncode — a zero-API-key agentic IDE and browser/PC harness driven by your logged-in gemini.google.com web session.",
  "key": "",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "scripting",
    "alarms",
    "debugger",
    "tabs",
    "tabGroups",
    "downloads",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "ws://127.0.0.1/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Gemini Chat",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Open Gemini Nexus Sidebar"
    },
    "quick-ask": {
      "suggested_key": {
        "default": "Alt+Q",
        "mac": "Alt+Q"
      },
      "description": "Open Gemini Nexus Quick Ask"
    },
    "area-ocr": {
      "suggested_key": {
        "default": "Alt+O",
        "mac": "Alt+O"
      },
      "description": "Start Gemini Nexus Area OCR"
    },
    "browser-control": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "Toggle Gemini Nexus Browser Control"
    }
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "sandbox": {
    "pages": [
      "sandbox/index.html"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/index.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/youtube_summary_bundle.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/shortcut_frame_bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/gemini_watermark_bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/gemini_dom_bridge.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://gemini.google.com/*",
        "https://business.gemini.google/*"
      ],
      "exclude_globs": [
        "*.mhtml*",
        "*.mht*",
        "*.MHTML*",
        "*.MHT*"
      ],
      "js": [
        "content/gemini_watermark_page.js",
        "vendor/gemini-watermark-remover/content_main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "sandbox/index.html",
        "assets/cursors/cursor-chat.png",
        "vendor/katex/katex.min.css",
        "vendor/katex/fonts/*",
        "vendor/highlight.js/atom-one-dark.min.css",
        "vendor/highlight.js/atom-one-light.min.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline'; img-src 'self' https: http: data: blob:; media-src https: http: data: blob:;"
  }
}
